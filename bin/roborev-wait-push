#!/usr/bin/env bash
# roborev-wait-push [ref]  - wait for the roborev review whose range ends at ref
# (default HEAD) in the current repo, and report whether it still blocks.
#
# Why: with post_commit_batch_size >= 2, the pre-push hook enqueues one range job
# (git_ref "<checkpoint>..<head>"). `roborev wait <sha>` matches git_ref exactly
# (cmd/roborev/daemon_client.go findJobForCommit, v0.71.0), so it reports
# "No job found" for a range head. This finds the newest review or range job
# whose git_ref is <sha> or ends in "..<sha>", waits on that job id, then reads
# the job's final state: a closed FAIL no longer blocks (whoever closed it:
# `roborev close`, or `roborev compact`, which closes its sources with no
# comment), and a job that errored is not a review verdict.
#
# Exit: 0 PASS, or a closed FAIL; 1 FAIL open;
#       2 no job found within the retry window, or the repo has no roborev jobs at all;
#       3 usage/git/daemon error, or the job was still unfinished after the wait (rerun);
#       4 the job finished without a verdict (agent error, canceled);
#       128+N killed by signal N (INTERRUPTED: rerun; not a daemon error).
#       The last line of output, on every path, names the result and the exit code
#       ("roborev-wait-push: PASS (exit 0)"), so `| tail -1` always shows it (stdout, after everything else).
#       Before that line, warnings on stderr name any OTHER open FAIL jobs and any
#       other queued or running jobs on the same branch (among the newest 200 jobs);
#       they don't change the exit code.
# Env:  ROBOREV_WAIT_PUSH_TIMEOUT  seconds to keep looking for the job (default 60)
set -euo pipefail

timeout="${ROBOREV_WAIT_PUSH_TIMEOUT:-60}"
interval=3
ref="${1:-HEAD}"

# Every exit goes through the EXIT trap, which prints the one final line. finish
# sets its label. A signal keeps its 128+N code as INTERRUPTED; any other exit
# that didn't come through finish (a `set -e` failure) is reported as ERROR
# with exit 3, keeping the exit-code contract.
result=""
# shellcheck disable=SC2329  # invoked by the EXIT trap
on_exit() {
  local rc=$?
  if [ -z "$result" ]; then
    if [ "$rc" -gt 128 ]; then result=INTERRUPTED; else result=ERROR; rc=3; fi
  fi
  echo "roborev-wait-push: $result (exit $rc)"
  exit "$rc"
}
trap on_exit EXIT
finish() { result=$1; exit "$2"; }

# A fatal signal doesn't reach on_exit with a 128+N status, so trap the common
# ones. `roborev wait` runs in the background so the trap fires at once rather
# than after it returns; the trap stops it.
wait_pid=""
# shellcheck disable=SC2329  # invoked by the signal traps
on_signal() {
  if [ -n "$wait_pid" ]; then kill "$wait_pid" 2>/dev/null || true; fi
  result=INTERRUPTED; exit "$1"
}
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

die() {
  local code="${2:-3}"
  echo "roborev-wait-push: $1" >&2
  if [ "$code" -eq 2 ]; then finish "NO JOB" 2; else finish ERROR "$code"; fi
}

[ $# -le 1 ] || die "usage: roborev-wait-push [ref]"
command -v roborev >/dev/null || die "roborev not on PATH"
command -v jq >/dev/null || die "jq not on PATH"

sha=$(git rev-parse --verify --quiet "${ref}^{commit}") || die "not a commit in this repo: $ref"
# roborev list resolves the repo from the working directory: right from a linked
# worktree's root or subdirectory, but empty from a main checkout's subdirectory
# (roborev v0.71.0), so list from the worktree root.
cd "$(git rev-parse --show-toplevel)" || die "could not find the worktree root"

# Sets $jobs in this shell (not a subshell), so a failure reports once and exits.
list_jobs() {
  jobs=$(roborev list --all-branches --json --limit 200) \
    || die "roborev list failed (daemon down?)"
}

deadline=$(( $(date +%s) + timeout ))
while :; do
  list_jobs
  n_jobs=$(jq 'length' <<<"$jobs") || die "could not parse roborev list output"
  # A repo with no jobs at all isn't hooked up; waiting won't change that.
  [ "$n_jobs" -gt 0 ] || die "roborev has no jobs for this repo; run roborev init here?" 2
  job_id=$(jq -r --arg sha "$sha" '
    [ .[]
      | select(.job_type == "review" or .job_type == "range")
      | select(.git_ref == $sha or (.git_ref | endswith(".." + $sha))) ]
    | max_by(.id) // empty | .id' <<<"$jobs") \
    || die "could not parse roborev list output"
  [ -n "$job_id" ] && break
  if [ "$(date +%s)" -ge "$deadline" ]; then
    die "no review job ends at ${sha:0:7} after ${timeout}s. Was it pushed? See ~/.roborev/post-commit.log" 2
  fi
  sleep "$interval"
done

echo "roborev-wait-push: ${sha:0:7} -> job $job_id" >&2
# Prints the review; its exit code is not the answer (it is 1 for a closed FAIL
# and for a job error alike), so the job's final state decides below.
roborev wait --job "$job_id" &
wait_pid=$!
wait "$wait_pid" || true
wait_pid=""

list_jobs
state=$(jq -r --argjson id "$job_id" '
  .[] | select(.id == $id) | "\(.status) \(.verdict // "-") \(.closed // false)"' <<<"$jobs") \
  || die "could not parse roborev list output"
[ -n "$state" ] || die "job $job_id is no longer listed"
read -r status verdict closed <<<"$state"

# This job's verdict can be clean while other jobs on the branch still carry
# open FAILs or haven't finished; name them so they aren't missed. Same listing,
# no second request, and no effect on the exit code.
if warnings=$(jq -r --argjson id "$job_id" '
    (.[] | select(.id == $id) | .branch // "") as $branch
    | select($branch != "")
    | [ .[] | select(.branch == $branch and .id != $id) ] as $others
    | ([ $others[] | select(.status == "done" and .verdict == "F" and ((.closed // false) | not)) | .id ]) as $fail
    | ([ $others[] | select(.status == "queued" or .status == "running") | .id ]) as $pending
    | (if ($fail | length) > 0 then "branch \($branch) has \($fail | length) other open FAIL job(s): \($fail | map(tostring) | join(" ")) (roborev list --all-branches --open)" else empty end),
      (if ($pending | length) > 0 then "branch \($branch) has \($pending | length) other unfinished (queued or running) job(s): \($pending | map(tostring) | join(" "))" else empty end)
    ' <<<"$jobs"); then
  while IFS= read -r line; do
    [ -z "$line" ] || echo "roborev-wait-push: warning: $line" >&2
  done <<<"$warnings"
else
  echo "roborev-wait-push: warning: could not check the branch's other jobs" >&2
fi

case "$status:$verdict:$closed" in
  done:P:*)    finish PASS 0 ;;
  done:F:true)
    # roborev compact closes the jobs it consolidates without a comment, so a
    # missing comment can't block; it only earns a nudge.
    echo "roborev-wait-push: job $job_id FAIL is closed; not blocking. If you closed it, prefer comment-then-close so later reviews learn (roborev comment --job $job_id -m ...)" >&2
    finish "PASS, FAIL closed" 0 ;;
  done:F:*)
    echo "roborev-wait-push: job $job_id FAIL is open: fix, or comment then close" >&2
    finish "FAIL open" 1 ;;
  queued:*|running:*)
    die "job $job_id is still $status after roborev wait returned; rerun" ;;
  *)
    error=$(jq -r --argjson id "$job_id" '.[] | select(.id == $id) | .error // "(no error recorded)"' <<<"$jobs") \
      || error="(could not read the job's error)"
    echo "roborev-wait-push: job $job_id ended '$status' with no verdict; not a review result. Error: $error" >&2
    finish "NO VERDICT, status $status" 4 ;;
esac
